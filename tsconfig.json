{
  "$schema": "https://raw.githubusercontent.com/Effect-TS/language-service/refs/heads/main/schema.json",
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "ignoreDeprecations": "6.0",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "types": ["bun"],

    // Bundler mode
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@mokronos/wfkit": ["packages/wf/src/index.ts"],
      "@mokronos/wfkit/authoring": ["packages/wf/src/authoring.ts"],
      "@mokronos/wfkit-executor": ["packages/wfkit-executor/src/index.ts"],
      "@mokronos/wfkit-executor/schemas": ["packages/wfkit-executor/src/schemas.ts"],
      "@mokronos/wfkit-executor/integration-model": ["packages/wfkit-executor/src/integration-model.ts"],
      "@mokronos/integrations": ["apps/integrations/gateway/src/index.ts"],
      "@mokronos/integrations/domain": ["apps/integrations/gateway/src/domain.ts"],
      "@mokronos/integrations-client": ["apps/integrations/ts/src/index.ts"],
      "@mokronos/integrations-cli/upgrade": ["apps/integrations/cli/src/upgrade.ts"],
      "@mokronos/wfkit/integrations": ["packages/wf/src/integration-contract.ts"],
      "@mokronos/wfkit/schemas": ["packages/wf/src/schemas.ts"],
      "@mokronos/wfkit/testing": ["packages/wf/src/testing/index.ts"]
    },
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "incremental": true,
    "composite": true,
    "sourceMap": true,
    "declarationMap": true,

    // Best practices
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noPropertyAccessFromIndexSignature": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "plugins": [
      {
        "name": "@effect/language-service"
      }
    ]
  },
  // The two React apps each own an `@/*` alias pointing at their own src, which
  // a single root project cannot resolve two ways. They are type-checked
  // through their own tsconfigs instead — see the `typecheck` script.
  "exclude": ["**/dist", "node_modules", "**/.tmp/**", "apps/wf/web", "apps/integrations/web"]
}
