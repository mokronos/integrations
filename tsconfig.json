{
  "$schema": "https://raw.githubusercontent.com/Effect-TS/language-service/refs/heads/main/schema.json",
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "ignoreDeprecations": "6.0",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "types": ["bun"],

    // Bundler mode
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@mokronos/integrations-observability": ["packages/observability/src/index.ts"],
      "@mokronos/integrations-protocol": ["packages/integrations-protocol/src/index.ts"],
      "@mokronos/integrations-protocol/schemas": ["packages/integrations-protocol/src/schemas.ts"],
      "@mokronos/integrations-protocol/integration-model": ["packages/integrations-protocol/src/integration-model.ts"],
      "@mokronos/integrations-protocol/registry": ["packages/integrations-protocol/src/registry.ts"],
      "@mokronos/integrations-protocol/version": ["packages/integrations-protocol/src/version.ts"],
      "@mokronos/integrations-executor": ["packages/integrations-executor/src/index.ts"],
      "@mokronos/integrations-executor/schemas": ["packages/integrations-executor/src/schemas.ts"],
      "@mokronos/integrations-executor/integration-model": ["packages/integrations-executor/src/integration-model.ts"],
      "@mokronos/integrations-executor/registry": ["packages/integrations-executor/src/registry.ts"],
      "@mokronos/integrations": ["apps/integrations/gateway/src/index.ts"],
      "@mokronos/integrations/domain": ["apps/integrations/gateway/src/domain.ts"],
      "@mokronos/integrations-client": ["apps/integrations/ts/src/index.ts"],
      "@mokronos/integrations-client/codegen": ["apps/integrations/ts/src/codegen.ts"]
    },
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "incremental": true,
    "composite": true,
    "sourceMap": true,
    "declarationMap": true,

    // Best practices
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noPropertyAccessFromIndexSignature": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "plugins": [
      {
        "name": "@effect/language-service"
      }
    ]
  },
  // The React app owns an `@/*` alias and the Worker owns its runtime types, so
  // both are type-checked through their own projects.
  // The vendored anti-slop Oxlint plugin is third-party tooling source, not
  // owned project source: it is type-checked upstream and does not compile
  // under this repo's stricter options. Oxlint ignores it too.
  "exclude": [
    "**/dist",
    "node_modules",
    "**/.tmp/**",
    "apps/integrations/web",
    "apps/integrations/worker",
    "tools/oxlint/anti-slop"
  ]
}
