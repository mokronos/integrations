{
  "$schema": "https://raw.githubusercontent.com/Effect-TS/language-service/refs/heads/main/schema.json",
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "ignoreDeprecations": "6.0",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "types": ["bun"],

    // Bundler mode
    "moduleResolution": "bundler",
    // Workspace packages resolve through their own `exports` maps. The
    // `development` condition is listed ahead of `types` in every manifest, so
    // enabling it here points type-checking at TypeScript sources instead of
    // `dist`, which no clean checkout has built yet.
    "customConditions": ["development"],
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "incremental": true,
    "composite": true,
    "sourceMap": true,
    "declarationMap": true,

    // Best practices
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noPropertyAccessFromIndexSignature": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "plugins": [
      {
        "name": "@effect/language-service"
      }
    ]
  },
  // The React app owns an `@/*` alias and the Worker owns its runtime types, so
  // both are type-checked through their own projects.
  // The vendored anti-slop Oxlint plugin is third-party tooling source, not
  // owned project source: it is type-checked upstream and does not compile
  // under this repo's stricter options. Oxlint ignores it too.
  "exclude": [
    "**/dist",
    "apps/local/web",
    "node_modules",
    "**/.tmp/**",
    "apps/web",
    "apps/landing",
    "apps/host-cloudflare",
    "tools/oxlint/anti-slop"
  ]
}
