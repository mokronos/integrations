{
  "$schema": "https://raw.githubusercontent.com/Effect-TS/language-service/refs/heads/main/schema.json",
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "ignoreDeprecations": "6.0",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "types": ["bun"],

    // Bundler mode
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@mokronos/observability": ["packages/observability/src/index.ts"],
      "@mokronos/contracts": ["packages/contracts/src/index.ts"],
      "@mokronos/core-integrations": ["packages/core/integrations/src/index.ts"],
      "@mokronos/integrations": ["packages/integrations/src/index.ts"],
      "@mokronos/gateway-core": ["packages/core/gateway/src/index.ts"],
      "@mokronos/gateway-api": ["packages/core/api/src/index.ts"],
      "@mokronos/integrations-local": ["apps/local/index.ts"],
      "@mokronos/integrations-client": ["apps/ts/src/index.ts"]
    },
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "incremental": true,
    "composite": true,
    "sourceMap": true,
    "declarationMap": true,

    // Best practices
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noPropertyAccessFromIndexSignature": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "plugins": [
      {
        "name": "@effect/language-service"
      }
    ]
  },
  // The React app owns an `@/*` alias and the Worker owns its runtime types, so
  // both are type-checked through their own projects.
  // The vendored anti-slop Oxlint plugin is third-party tooling source, not
  // owned project source: it is type-checked upstream and does not compile
  // under this repo's stricter options. Oxlint ignores it too.
  "exclude": [
    "**/dist",
    "node_modules",
    "**/.tmp/**",
    "apps/web",
    "apps/host-cloudflare",
    "tools/oxlint/anti-slop"
  ]
}
