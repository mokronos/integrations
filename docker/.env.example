# Seals every stored credential. Keep it out of backups of the data volume.
# Generate: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
INTEGRATIONS_MASTER_KEY=

# The URL users and OAuth providers reach the gateway at, behind your TLS proxy.
INTEGRATIONS_PUBLIC_URL=https://integrations.example.com

# INTEGRATIONS_PORT=4788
# INTEGRATIONS_GOOGLE_CLIENT_ID=
# INTEGRATIONS_GOOGLE_CLIENT_SECRET=
