{
  "name": "@mokronos/integrations-cli",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Agent-facing i CLI and its human/operator ii superset for the integration gateway.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mokronos/integrations.git",
    "directory": "apps/integrations/cli"
  },
  "homepage": "https://github.com/mokronos/integrations#readme",
  "bugs": "https://github.com/mokronos/integrations/issues",
  "keywords": [
    "integrations",
    "gateway",
    "cli",
    "agent"
  ],
  "bin": {
    "i": "src/agent.ts",
    "ii": "src/main.ts"
  },
  "engines": {
    "bun": ">=1.2"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "test:remote": "bun run test/remote.acceptance.ts",
    "typecheck": "tsc -p ../../../tsconfig.json --noEmit"
  },
  "dependencies": {
    "@effect/platform-bun": "catalog:",
    "@integrations/contracts": "workspace:*",
    "@integrations/gateway-api": "workspace:*",
    "@integrations/gateway-core": "workspace:*",
    "@mokronos/integrations-client": "workspace:*",
    "@integrations/integrations": "workspace:*",
    "@integrations/observability": "workspace:*",
    "effect": "catalog:"
  }
}
