{
  "name": "@integragents/cli",
  "version": "0.3.1",
  "type": "module",
  "description": "Agent-facing i CLI and its human/operator ii superset for the integration gateway.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mokronos/integrations.git",
    "directory": "apps/cli"
  },
  "homepage": "https://github.com/mokronos/integrations#readme",
  "bugs": "https://github.com/mokronos/integrations/issues",
  "keywords": [
    "integrations",
    "gateway",
    "cli",
    "agent"
  ],
  "bin": {
    "i": "src/agent.ts",
    "ii": "src/main.ts"
  },
  "engines": {
    "bun": ">=1.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "src",
    "!src/standalone.ts",
    "!src/embedded-web.d.ts",
    "README.md"
  ],
  "scripts": {
    "test:remote": "bun run test/remote.acceptance.ts",
    "typecheck": "tsc -p ../../../tsconfig.json --noEmit"
  },
  "dependencies": {
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@integragents/contracts": "workspace:^",
    "@integragents/gateway-api": "workspace:^",
    "@integragents/gateway-core": "workspace:^",
    "@integragents/local": "workspace:^",
    "@integragents/client": "workspace:^",
    "@integragents/host": "workspace:^",
    "@integragents/observability": "workspace:^",
    "effect": "catalog:"
  }
}
