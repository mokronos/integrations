{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // The hosted control-plane gateway. Storage lives in D1 (gateway tables and
  // Executor tables share one database), maintenance runs on the cron trigger,
  // and the dashboard is served as static assets ahead of this Worker.
  "name": "integrations-gateway",
  "main": "src/index.ts",
  // nodejs_compat is implicit from this date on; it brings the full node:crypto
  // surface the gateway's sealing and password hashing rely on.
  "compatibility_date": "2026-08-04",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /v1/* must always reach the gateway, never an asset with a lucky name.
    "run_worker_first": ["/v1/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "integrations-gateway",
      "database_id": "dc65083d-4387-43c4-89b8-d28e4a9fff65"
    }
  ],
  // Free plan allows up to five cron triggers per Worker; one is plenty. The
  // sweep is idempotent, so a missed tick only delays expiry housekeeping.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true
  },
  // Vendored third-party code drags two unshippable modules into the graph:
  // an MCP stdio transport that the runtime gate disables anyway, and a DNS
  // resolver behind a code path nothing calls. Both become build-time stubs.
  "alias": {
    "dns/promises": "./src/stubs/empty.ts",
    "@modelcontextprotocol/sdk/client/stdio.js": "./src/stubs/empty.ts",
    "@modelcontextprotocol/sdk/client/stdio": "./src/stubs/empty.ts"
  },
  "vars": {
    // OAuth callbacks land here; matches the deployed workers.dev origin.
    "INTEGRATIONS_PUBLIC_URL": "https://integrations-gateway.games-97f.workers.dev",
    // Public half of the Google OAuth client used for dashboard/ii sign-in.
    // Set its secret separately with `wrangler secret put INTEGRATIONS_GOOGLE_CLIENT_SECRET`.
    "INTEGRATIONS_GOOGLE_CLIENT_ID": "",
    // Open registration: each signup mints its own isolated tenant partition.
    "INTEGRATIONS_ALLOW_SIGNUP": "1"
  },
  "env": {
    "staging": {
      "name": "integrations-gateway-staging",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "integrations-gateway-staging",
          "database_id": "89a63ead-5bfc-4120-9211-96e58fc2fb42"
        }
      ],
      "vars": {
        "INTEGRATIONS_PUBLIC_URL": "https://integrations-gateway-staging.games-97f.workers.dev",
        "INTEGRATIONS_GOOGLE_CLIENT_ID": "",
        "INTEGRATIONS_ALLOW_SIGNUP": "1"
      }
    }
  }
}
