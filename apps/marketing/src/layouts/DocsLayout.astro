---
import type { MarkdownLayoutProps } from "astro"
import Layout from "./Layout.astro"
import "../styles/docs.css"

type Props = MarkdownLayoutProps<{
  title: string
  description: string
}>

const { frontmatter, headings } = Astro.props
const base = import.meta.env.BASE_URL.replace(/\/$/, "")
const githubUrl = "https://github.com/mokronos/wf"

const pages = [
  { href: `${base}/docs/`, label: "Overview", note: "Install, first run, where state lives" },
  { href: `${base}/docs/cli/`, label: "wf CLI", note: "Create, validate, run, signal, inspect" },
  { href: `${base}/docs/wfkit/`, label: "TypeScript SDK", note: "@mokronos/wfkit" },
  { href: `${base}/docs/integrations/`, label: "Integrations CLI", note: "Discover, connect, grant, approve" },
  { href: `${base}/docs/client/`, label: "Gateway client", note: "@mokronos/integrations-client" }
]

const current = Astro.url.pathname.replace(/\/$/, "")
const isCurrent = (href: string): boolean => href.replace(/\/$/, "") === current
const toc = headings.filter((heading) => heading.depth === 2)
---

<Layout title={`${frontmatter.title} — wf docs`} description={frontmatter.description}>
  <div class="docs">
    <header class="docs-header">
      <div class="docs-header-inner">
        <a class="brand" href={`${base}/`} aria-label="wf home">
          <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span>
          <span>www<span class="brand-slash">/</span>wf</span>
        </a>
        <span class="docs-tag">Docs</span>
        <nav class="docs-header-nav" aria-label="Site">
          <a href={`${base}/#get-started`}>Install</a>
          <a href={githubUrl}>GitHub <span aria-hidden="true">↗</span></a>
        </nav>
      </div>
    </header>

    <div class="docs-body">
      <aside class="docs-nav" aria-label="Documentation">
        <p class="docs-nav-title">Reference</p>
        <ul>
          {pages.map((page) => (
            <li>
              <a href={page.href} aria-current={isCurrent(page.href) ? "page" : undefined}>
                <strong>{page.label}</strong>
                <small>{page.note}</small>
              </a>
            </li>
          ))}
        </ul>
      </aside>

      <main class="docs-main">
        <article class="prose">
          <p class="docs-eyebrow">{frontmatter.title}</p>
          <slot />
        </article>
      </main>

      {toc.length > 1 && (
        <aside class="docs-toc" aria-label="On this page">
          <p class="docs-nav-title">On this page</p>
          <ul>
            {toc.map((heading) => (
              <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
            ))}
          </ul>
        </aside>
      )}
    </div>

    <footer class="docs-footer">
      <div class="docs-header-inner">
        <a class="brand" href={`${base}/`}>
          <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span>
          <span>www<span class="brand-slash">/</span>wf</span>
        </a>
        <p>Structured orchestration. Typed integrations. Code for computation.</p>
        <a href={githubUrl}>Open source on GitHub ↗</a>
      </div>
    </footer>
  </div>
</Layout>
