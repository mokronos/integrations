{
  "name": "@mokronos/integrations",
  "version": "0.2.0",
  "type": "module",
  "description": "The integration gateway — connections, grants, policy, and credential-injecting execution.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mokronos/wf.git",
    "directory": "apps/integrations/gateway"
  },
  "homepage": "https://github.com/mokronos/wf#readme",
  "bugs": "https://github.com/mokronos/wf/issues",
  "keywords": [
    "integrations",
    "gateway",
    "mcp",
    "openapi",
    "agent"
  ],
  "engines": {
    "bun": ">=1.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@mokronos/wfkit-executor": "workspace:*",
    "effect": "4.0.0-beta.59"
  }
}
