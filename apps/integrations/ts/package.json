{
  "name": "@mokronos/integrations-client",
  "version": "0.2.0",
  "type": "module",
  "description": "Thin client for the integration gateway. Auth, HTTP, decode — no integration logic.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mokronos/wf.git",
    "directory": "apps/integrations/ts"
  },
  "homepage": "https://github.com/mokronos/wf#readme",
  "bugs": "https://github.com/mokronos/wf/issues",
  "keywords": ["integrations", "gateway", "client", "agent"],
  "engines": { "bun": ">=1.2" },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org" },
  "files": ["src", "dist", "README.md"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "effect": "4.0.0-beta.59"
  }
}
