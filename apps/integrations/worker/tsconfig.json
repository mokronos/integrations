{
  "extends": "../../../tsconfig.json",
  // Type-checked through this project rather than the root one so the
  // Cloudflare runtime types can be imported per-file (D1Database & friends)
  // instead of installed globally, which would fight bun's own globals.
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "baseUrl": ".",
    "paths": {
      "@mokronos/integrations": ["../gateway/src/index.ts"],
      "@mokronos/integrations/domain": ["../gateway/src/domain.ts"],
      "@mokronos/integrations-observability": ["../../../packages/observability/src/index.ts"],
      "@mokronos/integrations-client": ["../ts/src/index.ts"],
      "@mokronos/integrations-executor": ["../../../packages/integrations-executor/src/index.ts"],
      "@mokronos/integrations-executor/schemas": ["../../../packages/integrations-executor/src/schemas.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules", ".wrangler"]
}
