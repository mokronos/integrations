{
  "name": "@mokronos/integrations",
  "version": "0.2.0",
  "type": "module",
  "description": "The integration gateway — connections, grants, policy, and credential-injecting execution.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mokronos/integrations.git",
    "directory": "apps/integrations/gateway"
  },
  "homepage": "https://github.com/mokronos/integrations#readme",
  "bugs": "https://github.com/mokronos/integrations/issues",
  "keywords": [
    "integrations",
    "gateway",
    "mcp",
    "openapi",
    "agent"
  ],
  "engines": {
    "bun": ">=1.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "src",
    "dist",
    "web",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./domain": {
      "types": "./dist/domain.d.ts",
      "bun": "./src/domain.ts",
      "development": "./src/domain.ts",
      "default": "./dist/domain.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "build:web": "bun run --cwd ../web build && rm -rf web && cp -R ../web/dist web",
    "prepublishOnly": "bun run build && bun run build:web"
  },
  "dependencies": {
    "@libsql/client": "catalog:",
    "@mokronos/contracts": "workspace:*",
    "@mokronos/integration-host": "workspace:*",
    "@mokronos/integrations-client": "workspace:*",
    "@mokronos/observability": "workspace:*",
    "effect": "catalog:",
    "@effect/platform-bun": "catalog:"
  }
}
