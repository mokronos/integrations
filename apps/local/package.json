{
  "name": "@integragents/local",
  "version": "0.3.0",
  "type": "module",
  "description": "Local Bun host for the integrations gateway.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mokronos/integrations.git",
    "directory": "apps/local"
  },
  "homepage": "https://github.com/mokronos/integrations#readme",
  "bugs": "https://github.com/mokronos/integrations/issues",
  "keywords": [
    "integrations",
    "gateway",
    "mcp",
    "openapi",
    "agent"
  ],
  "engines": {
    "bun": ">=1.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "dist",
    "web",
    "index.ts",
    "README.md"
  ],
  "exports": {
    ".": {
      "development": "./index.ts",
      "bun": "./index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && bun run build:web",
    "build:web": "bun run --cwd ../web build && rm -rf web && cp -R ../web/dist web",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@integragents/contracts": "workspace:^",
    "@integragents/gateway-api": "workspace:^",
    "@integragents/gateway-core": "workspace:^",
    "@integragents/client": "workspace:^",
    "effect": "catalog:"
  }
}
