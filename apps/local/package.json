{
  "name": "@mokronos/integrations",
  "version": "0.2.0",
  "type": "module",
  "description": "Local Bun host for the integrations gateway.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mokronos/integrations.git",
    "directory": "apps/local"
  },
  "homepage": "https://github.com/mokronos/integrations#readme",
  "bugs": "https://github.com/mokronos/integrations/issues",
  "keywords": [
    "integrations",
    "gateway",
    "mcp",
    "openapi",
    "agent"
  ],
  "engines": {
    "bun": ">=1.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "dist",
    "web",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && bun run build:web",
    "build:web": "bun run --cwd ../web build && rm -rf web && cp -R ../web/dist web",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@integrations/gateway-api": "workspace:*",
    "@integrations/gateway-core": "workspace:*",
    "@mokronos/integrations-client": "workspace:*",
    "effect": "catalog:"
  }
}
