{
  "name": "@mokronos/integrations-host-cloudflare",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "The integrations gateway deployed as a Cloudflare Worker: D1 storage, cron-driven maintenance, static dashboard assets.",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:staging": "bun run --cwd ../web build && wrangler deploy --env staging",
    "tail": "wrangler tail"
  },
  "dependencies": {
    "@effect/sql-d1": "catalog:",
    "@mokronos/integrations-contracts": "workspace:*",
    "@mokronos/integrations-gateway-api": "workspace:*",
    "@mokronos/integrations-gateway-core": "workspace:*",
    "@mokronos/integrations-host": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "wrangler": "catalog:"
  }
}
