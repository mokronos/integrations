{
  "extends": "../../tsconfig.json",
  // Type-checked through this project rather than the root one so the
  // Cloudflare runtime types can be imported per-file (D1Database & friends)
  // instead of installed globally, which would fight bun's own globals.
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "baseUrl": ".",
    "paths": {
      "@mokronos/observability": ["../../packages/observability/src/index.ts"],
      "@mokronos/contracts": ["../../packages/contracts/src/index.ts"],
      "@mokronos/integration-host": ["../../packages/integration-host/src/index.ts"],
      "@mokronos/gateway-core": ["../../packages/core/gateway/src/index.ts"],
      "@mokronos/gateway-api": ["../../packages/core/api/src/index.ts"],
      "@mokronos/integrations-client": ["../../apps/ts/src/index.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules", ".wrangler"]
}
