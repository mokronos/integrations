{
  "extends": "../../tsconfig.json",
  // Type-checked through this project rather than the root one so the
  // Cloudflare runtime types stay out of bun's globals.
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src", "test", "alchemy.run.ts"],
  "exclude": ["dist", "node_modules", ".alchemy"]
}
