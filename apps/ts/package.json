{
  "name": "@mokronos/integrations-client",
  "version": "0.3.0",
  "type": "module",
  "description": "Thin client for the integration gateway. Auth, HTTP, decode \u2014 no integration logic.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mokronos/integrations.git",
    "directory": "apps/integrations/ts"
  },
  "homepage": "https://github.com/mokronos/integrations#readme",
  "bugs": "https://github.com/mokronos/integrations/issues",
  "keywords": [
    "integrations",
    "gateway",
    "client",
    "agent"
  ],
  "engines": {
    "bun": ">=1.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "development": "./src/client.ts",
      "bun": "./src/client.ts",
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@mokronos/integrations-contracts": "workspace:^",
    "@mokronos/integrations-gateway-api": "workspace:^",
    "effect": "catalog:"
  }
}
