# Copy to .env.local.op, point each reference at your vault, then:
#   bun run with:local -- bun run ii serve
INTEGRATIONS_GOOGLE_CLIENT_ID=op://<vault>/integrations-google/client-id
INTEGRATIONS_GOOGLE_CLIENT_SECRET=op://<vault>/integrations-google/client-secret
OTEL_EXPORTER_OTLP_HEADERS=op://<vault>/integrations-otlp/headers
