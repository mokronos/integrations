# Copy to .env.deploy.op, point each reference at your vault, then:
#   bun run with:deploy -- bun run --cwd apps/host-cloudflare deploy -- --stage staging
CLOUDFLARE_ACCOUNT_ID=op://<vault>/cloudflare/account-id
CLOUDFLARE_API_TOKEN=op://<vault>/cloudflare/api-token
INTEGRATIONS_GOOGLE_CLIENT_ID=op://<vault>/integrations-google/client-id
INTEGRATIONS_GOOGLE_CLIENT_SECRET=op://<vault>/integrations-google/client-secret
OTEL_EXPORTER_OTLP_HEADERS=op://<vault>/integrations-otlp/headers
