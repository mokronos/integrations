{
  "name": "@mokronos/integrations-executor",
  "version": "0.2.0",
  "type": "module",
  "description": "The gateway's integration host: MCP and OpenAPI catalog, connections, and tool invocation.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mokronos/integrations.git",
    "directory": "packages/integrations-executor"
  },
  "homepage": "https://github.com/mokronos/integrations#readme",
  "keywords": [
    "gateway",
    "integration",
    "mcp",
    "openapi",
    "oauth",
    "agent"
  ],
  "engines": {
    "bun": ">=1.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas.d.ts",
      "bun": "./src/schemas.ts",
      "development": "./src/schemas.ts",
      "default": "./dist/schemas.js"
    },
    "./integration-model": {
      "types": "./dist/integration-model.d.ts",
      "bun": "./src/integration-model.ts",
      "development": "./src/integration-model.ts",
      "default": "./dist/integration-model.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "bun": "./src/registry.ts",
      "development": "./src/registry.ts",
      "default": "./dist/registry.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@libsql/client": "0.17.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@mokronos/integrations-protocol": "workspace:*",
    "effect": "4.0.0-beta.59",
    "oas": "^38.3.0",
    "oas-normalize": "^17.0.1"
  }
}
