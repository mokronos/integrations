{
  "name": "@integrations/gateway-core",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Gateway domain, persistence, authorization, and execution policy.",
  "license": "MIT",
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./domain": {
      "types": "./dist/domain.d.ts",
      "bun": "./src/domain.ts",
      "development": "./src/domain.ts",
      "default": "./dist/domain.js"
    },
    "./test-fixtures": {
      "bun": "./test/fixtures.ts",
      "development": "./test/fixtures.ts",
      "default": "./test/fixtures.ts"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "db:generate": "drizzle-kit generate && bun run scripts/embed-migrations.ts"
  },
  "dependencies": {
    "@effect/sql-libsql": "catalog:",
    "@libsql/client": "catalog:",
    "@integrations/contracts": "workspace:*",
    "@integrations/integrations": "workspace:*",
    "@mokronos/integrations-client": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "drizzle-kit": "catalog:",
    "drizzle-orm": "catalog:"
  }
}
