{
  "name": "@integragents/gateway-core",
  "version": "0.3.0",
  "type": "module",
  "description": "Gateway domain, persistence, authorization, and execution policy.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mokronos/integrations.git",
    "directory": "packages/core/gateway"
  },
  "homepage": "https://github.com/mokronos/integrations#readme",
  "bugs": "https://github.com/mokronos/integrations/issues",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./domain": {
      "development": "./src/domain.ts",
      "bun": "./src/domain.ts",
      "types": "./dist/domain.d.ts",
      "default": "./dist/domain.js"
    },
    "./test-fixtures": {
      "development": "./test/fixtures.ts",
      "bun": "./test/fixtures.ts"
    },
    "./schema": {
      "development": "./src/db/schema.ts",
      "bun": "./src/db/schema.ts",
      "types": "./dist/db/schema.d.ts",
      "default": "./dist/db/schema.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "db:generate": "drizzle-kit generate && bun run ../../../scripts/embed-migrations.ts --package . --out src/store-migrations.gen.ts --name gatewayMigrations --type-import @integragents/host",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@cfworker/json-schema": "catalog:",
    "@integragents/contracts": "workspace:^",
    "@integragents/host": "workspace:^"
  },
  "peerDependencies": {
    "@effect/sql-libsql": "catalog:",
    "@libsql/client": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "drizzle-kit": "catalog:"
  }
}
