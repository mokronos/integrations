      "bun": "./src/http/api.ts",
      "workerd": "./src/http/api.ts",
      "types": "./dist/http/api.d.ts",
      "default": "./dist/http/api.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@modelcontextprotocol/server": "^2.0.0",
    "@integragents/contracts": "workspace:^",
    "@integragents/gateway-core": "workspace:^",
    "@integragents/host": "workspace:^",
    "@integragents/observability": "workspace:^"
