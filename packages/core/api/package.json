{
  "name": "@integragents/gateway-api",
  "version": "0.3.1",
  "type": "module",
  "description": "Gateway HTTP API definitions, handlers, and server assembly.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mokronos/integrations.git",
    "directory": "packages/core/api"
  },
  "homepage": "https://github.com/mokronos/integrations#readme",
  "bugs": "https://github.com/mokronos/integrations/issues",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "bun": "./src/index.ts",
      "workerd": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./definition": {
