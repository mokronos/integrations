{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "composite": false,
    "incremental": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    // Emit resolves workspace dependencies to their built `dist` declarations,
    // so the `development` condition the root config enables is dropped here.
    "customConditions": []
  },
  "include": ["src"]
}
