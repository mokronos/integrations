{
  "name": "@mokronos/integrations-protocol",
  "version": "0.2.0",
  "type": "module",
  "description": "Effect Schema contracts shared by the integrations gateway, client, and executor.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mokronos/integrations.git",
    "directory": "packages/integrations-protocol"
  },
  "homepage": "https://github.com/mokronos/integrations#readme",
  "bugs": "https://github.com/mokronos/integrations/issues",
  "keywords": ["integrations", "protocol", "effect", "schema"],
  "engines": { "bun": ">=1.2" },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org" },
  "files": ["src", "dist", "README.md"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas.d.ts",
      "bun": "./src/schemas.ts",
      "development": "./src/schemas.ts",
      "default": "./dist/schemas.js"
    },
    "./integration-model": {
      "types": "./dist/integration-model.d.ts",
      "bun": "./src/integration-model.ts",
      "development": "./src/integration-model.ts",
      "default": "./dist/integration-model.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "bun": "./src/registry.ts",
      "development": "./src/registry.ts",
      "default": "./dist/registry.js"
    },
    "./version": {
      "types": "./dist/version.d.ts",
      "bun": "./src/version.ts",
      "development": "./src/version.ts",
      "default": "./dist/version.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run build"
  },
  "dependencies": { "effect": "4.0.0-beta.59" }
}
