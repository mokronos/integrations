{
  "name": "@mokronos/integrations-host",
  "version": "0.2.3",
  "type": "module",
  "description": "MCP and OpenAPI catalog, connections, and tool invocation.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mokronos/integrations.git",
    "directory": "packages/integrations"
  },
  "homepage": "https://github.com/mokronos/integrations#readme",
  "bugs": "https://github.com/mokronos/integrations/issues",
  "keywords": [
    "gateway",
    "integration",
    "mcp",
    "openapi",
    "oauth",
    "agent"
  ],
  "engines": {
    "node": ">=22",
    "bun": ">=1.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "development": "./src/db/schema.ts",
      "bun": "./src/db/schema.ts",
      "types": "./dist/db/schema.d.ts",
      "default": "./dist/db/schema.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test:conformance": "bun --bun run --cwd ../.. vitest run packages/integrations/test/conformance/reference",
    "test:remote": "RUN_REMOTE_INTEGRATION_TESTS=1 bun --bun run --cwd ../.. vitest run packages/integrations/test/conformance/remote",
    "db:generate": "drizzle-kit generate && bun run ../../scripts/embed-migrations.ts --package . --out src/storage/migrations.gen.ts --name integrationMigrations --type-import ./migrate.ts",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@mokronos/integrations-contracts": "workspace:^",
    "oas": "catalog:",
    "oas-normalize": "catalog:"
  },
  "peerDependencies": {
    "@effect/sql-libsql": "catalog:",
    "@libsql/client": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "drizzle-kit": "catalog:"
  }
}
