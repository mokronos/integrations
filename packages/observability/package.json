{
  "name": "@mokronos/integrations-observability",
  "version": "0.3.0",
  "type": "module",
  "description": "Tracing and logging for the integrations gateway and CLIs: a local trace file, console logs, and OTLP export.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mokronos/integrations.git",
    "directory": "packages/observability"
  },
  "homepage": "https://github.com/mokronos/integrations#readme",
  "bugs": "https://github.com/mokronos/integrations/issues",
  "keywords": [
    "integrations",
    "observability",
    "opentelemetry",
    "otlp",
    "effect"
  ],
  "engines": {
    "node": ">=22",
    "bun": ">=1.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@mokronos/integrations-contracts": "workspace:^"
  },
  "peerDependencies": {
    "effect": "catalog:"
  }
}
