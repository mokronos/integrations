{
  "name": "integrations-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/integrations/*",
    "packages/*"
  ],
  "overrides": {
    "@effect/platform-node-shared": "4.0.0-beta.59",
    "effect": "4.0.0-beta.59"
  },
  "scripts": {
    "build:observability": "bun run --cwd packages/observability build",
    "build:executor": "bun run --cwd packages/integrations-executor build",
    "build:client": "bun run --cwd apps/integrations/ts build",
    "build:gateway": "bun run build:observability && bun run build:executor && bun run build:client && bun run --cwd apps/integrations/gateway build",
    "build": "bun run build:gateway",
    "dev:control-plane": "bun run --cwd apps/integrations/web dev",
    "build:control-plane": "bun run --cwd apps/integrations/web build",
    "serve:control-plane": "bun run build:control-plane && INTEGRATIONS_WEB_DIR=\"$PWD/apps/integrations/web/dist\" bun run apps/integrations/cli/src/main.ts serve",
    "dashboard:control-plane": "bun run apps/integrations/cli/src/main.ts dashboard",
    "refresh:control-plane": "bun run build:control-plane && bun run dashboard:control-plane",
    "i": "bun run apps/integrations/cli/src/agent.ts",
    "ii": "bun run apps/integrations/cli/src/main.ts",
    "cli": "bun run ii",
    "lint": "oxlint",
    "prepare": "effect-language-service patch",
    "typecheck": "tsc --build --noEmit && tsc -p apps/integrations/web && tsc -p apps/integrations/worker",
    "test": "bun test",
    "verify": "bun run lint && bun run typecheck && bun test && bun run build && bun run build:control-plane"
  },
  "devDependencies": {
    "@effect/language-service": "^0.86.4",
    "@oxlint/plugins": "1.79.0",
    "@types/bun": "latest",
    "effect-solutions": "^0.5.3",
    "oxlint": "1.79.0",
    "typescript": "^6.0.3"
  }
}
