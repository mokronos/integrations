{
  "name": "integrations-monorepo",
  "private": true,
  "type": "module",
  "version": "0.2.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/*/*"
  ],
  "catalog": {
    "@cloudflare/workers-types": "5.20260822.1",
    "@effect/language-service": "^0.86.4",
    "@effect/platform-bun": "rc",
    "@effect/platform-node-shared": "rc",
    "@fontsource-variable/geist": "^5.2.9",
    "@libsql/client": "0.17.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@oxlint/plugins": "1.79.0",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-query": "^5.90.2",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "effect": "rc",
    "effect-solutions": "^0.5.3",
    "lucide-react": "^1.23.0",
    "oas": "^38.3.0",
    "oas-normalize": "^17.0.1",
    "oxlint": "1.79.0",
    "radix-ui": "^1.6.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^7.9.3",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.1",
    "wrangler": "4.125.0"
  },
  "overrides": {
    "@effect/platform-node-shared": "catalog:",
    "effect": "catalog:"
  },
  "scripts": {
    "build:observability": "bun run --cwd packages/observability build",
    "build:client": "bun run --cwd apps/ts build",
    "build:gateway": "bun run build:contracts && bun run build:client && bun run build:core-integrations && bun run build:observability && bun run build:host && bun run build:gateway-core && bun run build:gateway-api && bun run --cwd apps/local build",
    "build": "bun run build:gateway",
    "dev:control-plane": "bun run --cwd apps/web dev",
    "build:control-plane": "bun run build && bun run --cwd apps/web build",
    "serve:control-plane": "bun run build:control-plane && INTEGRATIONS_WEB_DIR=\"$PWD/apps/web/dist\" bun run apps/cli/src/main.ts serve",
    "dashboard:control-plane": "bun run apps/cli/src/main.ts dashboard",
    "refresh:control-plane": "bun run build:control-plane && bun run dashboard:control-plane",
    "i": "bun run apps/cli/src/agent.ts",
    "ii": "bun run apps/cli/src/main.ts",
    "install:local": "bun run apps/cli/install-local.ts",
    "refresh": "bun run scripts/refresh.ts",
    "db:generate": "bun run --cwd packages/core/gateway db:generate",
    "lint": "oxlint",
    "prepare": "effect-language-service patch",
    "typecheck": "tsc --build --noEmit && tsc -p apps/web && tsc -p apps/host-cloudflare",
    "test": "bun test",
    "verify": "bun run lint && bun run typecheck && bun test && bun run build:control-plane",
    "build:contracts": "bun run --cwd packages/contracts build",
    "build:core-integrations": "bun run --cwd packages/core/integrations build",
    "build:host": "bun run --cwd packages/integrations build",
    "build:gateway-core": "bun run --cwd packages/core/gateway build",
    "build:gateway-api": "bun run --cwd packages/core/api build"
  },
  "dependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@oxlint/plugins": "catalog:",
    "@types/bun": "catalog:",
    "effect-solutions": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  }
}
